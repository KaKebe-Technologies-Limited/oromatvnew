# Oroma TV app — copy to .env and edit. Only EXPO_PUBLIC_* variables reach the app code.
#
# "auto" (or empty) while developing: the app finds the API on the same computer that runs `npx expo start`
# (http://<that computer's address>/oromatvnew/api), so it keeps working when your Wi-Fi address changes.
# To point at a different server, give the full address (no trailing slash), for example:
#   EXPO_PUBLIC_API_URL=http://192.168.0.103/oromatvnew/api
#   EXPO_PUBLIC_API_URL=https://oromatv.com/api
EXPO_PUBLIC_API_URL=auto
EXPO_PUBLIC_APP_ENV=development
